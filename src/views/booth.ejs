<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#ff4d6d">
    <link rel="icon" href="/icons/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
</head>

<body class="retro-page booth-page">
    <div class="stars"></div>
    <main class="interaction-card">
        <img src="/icons/logo.webp" alt="FICE" class="site-logo">
        <h1>Stand da Feira</h1>
        <p>Toque o botão para registrar sua visita e ganhar sua recompensa.</p>
        <video id="video" autoplay muted playsinline></video>
        <button id="captureBtn" disabled>Carregando câmera...</button>
        <div id="status"></div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <script src="/js/face-utils.js"></script>
    <script src="/js/pwa.js" defer></script>
    <script>
        const video = document.getElementById('video');
        const btn = document.getElementById('captureBtn');
        const statusEl = document.getElementById('status');
        const AUTO_RETRY_MS = 1500;
        const NEXT_PERSON_DELAY_MS = 2500;
        let isProcessing = false;

        function playSuccessSound() {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;

            const ctx = new AudioCtx();
            const notes = [
                { freq: 880, duration: 0.08, gain: 0.30, delay: 0 },
                { freq: 1174.66, duration: 0.08, gain: 0.30, delay: 0.08 },
                { freq: 1174.66, duration: 0.12, gain: 0.30, delay: 0.16 },
                { freq: 1567.98, duration: 0.16, gain: 0.30, delay: 0.28 },
            ];

            notes.forEach(({ freq, duration, gain, delay }) => {
                const osc = ctx.createOscillator();
                const gainNode = ctx.createGain();
                osc.type = 'square';
                osc.frequency.value = freq;
                gainNode.gain.setValueAtTime(0.0001, ctx.currentTime + delay);
                gainNode.gain.exponentialRampToValueAtTime(gain, ctx.currentTime + delay + 0.02);
                gainNode.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + delay + duration);
                osc.connect(gainNode);
                gainNode.connect(ctx.destination);
                osc.start(ctx.currentTime + delay);
                osc.stop(ctx.currentTime + delay + duration);
            });
        }

        function playErrorSound() {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;

            const ctx = new AudioCtx();
            const notes = [
                { freq: 220, duration: 0.10, gain: 0.26, delay: 0 },
                { freq: 180, duration: 0.12, gain: 0.26, delay: 0.10 },
            ];

            notes.forEach(({ freq, duration, gain, delay }) => {
                const osc = ctx.createOscillator();
                const gainNode = ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.value = freq;
                gainNode.gain.setValueAtTime(0.0001, ctx.currentTime + delay);
                gainNode.gain.exponentialRampToValueAtTime(gain, ctx.currentTime + delay + 0.02);
                gainNode.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + delay + duration);
                osc.connect(gainNode);
                gainNode.connect(ctx.destination);
                osc.start(ctx.currentTime + delay);
                osc.stop(ctx.currentTime + delay + duration);
            });
        }

        function hideActionButton() {
            btn.hidden = true;
            btn.disabled = true;
        }

        function scheduleNextPerson() {
            setTimeout(() => {
                isProcessing = false;
                verifyFace();
            }, NEXT_PERSON_DELAY_MS);
        }

        async function verifyFace() {
            if (isProcessing) return;

            isProcessing = true;
            hideActionButton();
            statusEl.textContent = 'Detectando rosto...';

            try {
                const embedding = await captureDescriptor(video);
                if (!embedding) {
                    statusEl.textContent = 'Posicione o rosto na câmera para continuar.';
                    setTimeout(() => {
                        isProcessing = false;
                        verifyFace();
                    }, AUTO_RETRY_MS);
                    return;
                }

                statusEl.textContent = 'Enviando...';
                const result = await sendToApi('/api/capture', embedding);

                if (result.status === 'registered') {
                    statusEl.textContent = 'Visita registrada com sucesso! Próxima pessoa em instantes.';
                    playSuccessSound();
                } else if (result.status === 'already_registered') {
                    statusEl.textContent = 'Você já estava registrado. Próxima pessoa em instantes.';
                    playSuccessSound();
                } else {
                    statusEl.textContent = 'Erro: ' + (result.error || 'tente novamente');
                    playErrorSound();
                }

                scheduleNextPerson();
            } catch (error) {
                console.error(error);
                statusEl.textContent = 'Não foi possível verificar seu rosto. Próxima pessoa em instantes.';
                playErrorSound();
                scheduleNextPerson();
            }
        }

        async function init() {
            try {
                await loadModels();
                await startWebcam(video);
                statusEl.textContent = 'Câmera pronta!';
                verifyFace();
            } catch (error) {
                console.error(error);
                statusEl.textContent = 'Não foi possível carregar o reconhecimento facial.';
            }
        }

        init();
    </script>

    <footer class="site-footer">
        <p>&copy; Desenvolvido pela Fábrica de Software - IFC Videira </p>
        <div class="footer-links">
            <a href="https://fabrica.videira.ifc.edu.br/" target="_blank" rel="noopener noreferrer"
                aria-label="Site da Fábrica de Software"><i class="fa-solid fa-globe"></i></a>
            <a href="https://www.instagram.com/fsw.ifcvideira" target="_blank" rel="noopener noreferrer"
                aria-label="Instagram da Fábrica de Software"><i class="fa-brands fa-instagram"></i></a>
        </div>
    </footer>
    <button id="pwaInstallBtn" class="btn pwa-install-button">Instalar app</button>
</body>

</html>